---
interface Props {
  goal?: 'learn' | 'save' | 'create' | 'explore';
}

const { goal = 'learn' } = Astro.props;
---

<link rel="stylesheet" href="/styles/child-experience.css" />

<section class="child-experience" data-goal={goal} aria-labelledby="child-title">
  <div class="child-experience__orb child-experience__orb--one" aria-hidden="true"></div>
  <div class="child-experience__orb child-experience__orb--two" aria-hidden="true"></div>

  <header class="child-topbar">
    <a class="child-brand" href="/" aria-label="Promptendium home">
      <span class="child-brand__mark" aria-hidden="true">P</span>
      <span>Promptendium</span>
    </a>

    <div class="child-mode-chip" aria-label="Young explorers area">
      <span class="child-mode-chip__dot" aria-hidden="true"></span>
      For young explorers
    </div>
  </header>

  <div class="child-layout">
    <div class="child-main">
      <div class="child-kicker">AI works better when your question does.</div>
      <h1 id="child-title">Ask better.<br /><span>Learn smarter.</span></h1>
      <p class="child-intro" data-goal-intro>
        Turn a quick question into one that helps you really understand the answer.
      </p>

      <div class="child-question-row">
        <p class="child-question">What do you want AI to help you with?</p>
        <span class="child-skill-badge" aria-label="Skill one: be specific">Skill 01 · Be specific</span>
      </div>

      <div class="child-missions" role="group" aria-label="Choose what you want help with">
        <button class="child-card is-active" type="button" data-mission="learn" aria-pressed="true">
          <span class="child-card__icon" aria-hidden="true">
            <svg viewBox="0 0 24 24"><path d="M4 5.5A2.5 2.5 0 0 1 6.5 3H20v15H6.5A2.5 2.5 0 0 0 4 20.5v-15Z"/><path d="M4 20.5A2.5 2.5 0 0 1 6.5 18H20"/></svg>
          </span>
          <span class="child-card__copy"><strong>Learn</strong><small>Understand something</small></span>
          <span class="child-card__arrow" aria-hidden="true">↗</span>
        </button>

        <button class="child-card" type="button" data-mission="create" aria-pressed="false">
          <span class="child-card__icon" aria-hidden="true">
            <svg viewBox="0 0 24 24"><path d="m12 3 1.6 4.4L18 9l-4.4 1.6L12 15l-1.6-4.4L6 9l4.4-1.6L12 3Z"/><path d="m18.5 15 .8 2.2 2.2.8-2.2.8-.8 2.2-.8-2.2-2.2-.8 2.2-.8.8-2.2Z"/></svg>
          </span>
          <span class="child-card__copy"><strong>Create</strong><small>Make something new</small></span>
          <span class="child-card__arrow" aria-hidden="true">↗</span>
        </button>

        <button class="child-card" type="button" data-mission="solve" aria-pressed="false">
          <span class="child-card__icon" aria-hidden="true">
            <svg viewBox="0 0 24 24"><path d="M9 4.5A3.5 3.5 0 0 1 12.5 8v1H15a3 3 0 1 1 0 6h-2.5v1A3.5 3.5 0 1 1 9 12.5V11H7a3 3 0 1 1 0-6h2V4.5Z"/></svg>
          </span>
          <span class="child-card__copy"><strong>Solve</strong><small>Work through a problem</small></span>
          <span class="child-card__arrow" aria-hidden="true">↗</span>
        </button>

        <button class="child-card" type="button" data-mission="explore" aria-pressed="false">
          <span class="child-card__icon" aria-hidden="true">
            <svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="8"/><path d="m14.8 9.2-1.9 3.7-3.7 1.9 1.9-3.7 3.7-1.9Z"/></svg>
          </span>
          <span class="child-card__copy"><strong>Explore</strong><small>Discover something interesting</small></span>
          <span class="child-card__arrow" aria-hidden="true">↗</span>
        </button>
      </div>

      <div class="child-quick-actions" aria-label="Helpful ways to use AI">
        <button type="button" data-quick="hint">Give me a hint</button>
        <button type="button" data-quick="quiz">Test what I know</button>
        <button type="button" data-quick="example">Show an example</button>
      </div>
    </div>

    <aside class="child-lab" aria-labelledby="child-lab-title">
      <div class="child-lab__top">
        <div>
          <span class="child-lab__eyebrow">Prompt Lab</span>
          <h2 id="child-lab-title">Let’s make that question better.</h2>
        </div>
        <div class="child-level" aria-label="Prompt skill level 2 of 4">
          <span>Skill level</span>
          <div class="child-level__bars" aria-hidden="true"><i></i><i></i><i></i><i></i></div>
        </div>
      </div>

      <div class="child-transform">
        <div class="child-prompt child-prompt--weak">
          <div class="child-prompt__label"><span aria-hidden="true"></span>Quick question</div>
          <p data-weak-prompt>Tell me about volcanoes.</p>
        </div>

        <div class="child-transform__step" aria-hidden="true">
          <span>+</span>
          <strong>Add what helps</strong>
          <div class="child-transform__line"></div>
        </div>

        <div class="child-builder" aria-label="Ingredients of a stronger prompt">
          <span data-builder-one>what you want</span>
          <span data-builder-two>your level</span>
          <span data-builder-three>an example</span>
        </div>

        <div class="child-prompt child-prompt--strong">
          <div class="child-prompt__label"><span aria-hidden="true">✓</span>Better prompt</div>
          <p data-better-prompt>Explain how volcanoes form in simple language for a 12-year-old. Use a real-world example, then ask me three questions to check I understood it.</p>
          <button type="button" class="child-remix" data-remix>Make another version</button>
        </div>
      </div>

      <div class="child-lab__footer">
        <div class="child-tip">
          <span class="child-tip__icon" aria-hidden="true">
            <svg viewBox="0 0 24 24"><path d="M12 3a6 6 0 0 0-3.8 10.65c.84.68 1.3 1.37 1.3 2.35h5c0-.98.46-1.67 1.3-2.35A6 6 0 0 0 12 3Z"/><path d="M9.5 19h5M10.5 22h3"/></svg>
          </span>
          <span><strong>Think first.</strong> Use AI for clues, examples and feedback — not to replace your own work.</span>
        </div>
        <button class="child-privacy" type="button" aria-describedby="child-privacy-note">
          <svg aria-hidden="true" viewBox="0 0 24 24"><path d="M7 10V8a5 5 0 0 1 10 0v2"/><rect x="5" y="10" width="14" height="10" rx="2"/></svg>
          Keep private things private
        </button>
        <span id="child-privacy-note" class="child-sr-only">Never put your full name, address, school details or passwords into an AI prompt.</span>
      </div>
    </aside>
  </div>

  <div class="child-privacy-popover" data-privacy-popover hidden role="status">
    <strong>Keep personal info out of prompts.</strong>
    <span>Don’t share your full name, home address, school details, passwords or private photos.</span>
  </div>
</section>

<script src="/scripts/child-experience.js" is:inline></script>
