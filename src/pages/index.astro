---
import '../styles/global.css';
import '../styles/animation-slow.css';
import '../styles/theme.css';
import '../styles/audience.css';
import '../styles/experience.css';

const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const logo = `${base}brand/promptendium-logo.webp`;
const favicon = `${base}favicon.png`;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>Promptendium — Less guessing. Better prompting.</title>
    <meta name="description" content="Practical AI prompts and guidance for children, everyday users and technical users." />
    <meta name="theme-color" content="#F7F6F2" id="themeColor" />
    <link rel="icon" type="image/png" href={favicon} />
    <script is:inline>
      (() => {
        try {
          const savedTheme = localStorage.getItem('promptendium-theme');
          const theme = savedTheme || (window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
          document.documentElement.dataset.theme = theme;

          const savedLevel = localStorage.getItem('promptendium-level');
          document.documentElement.dataset.level = ['children', 'everyday', 'technical'].includes(savedLevel) ? savedLevel : 'everyday';
        } catch {
          document.documentElement.dataset.theme = 'light';
          document.documentElement.dataset.level = 'everyday';
        }
      })();
    </script>
  </head>
  <body>
    <div class="page-shell">
      <header class="site-header entrance header-entrance">
        <div class="wrap header-inner">
          <a class="brand" href={base} aria-label="Promptendium home">
            <img src={logo} alt="Promptendium — The reference for better AI prompts." />
          </a>

          <div class="header-actions">
            <button class="theme-toggle" id="themeToggle" type="button" aria-label="Switch to dark mode" aria-pressed="false">
              <span class="theme-toggle-track" aria-hidden="true">
                <span class="theme-toggle-sun">☀</span>
                <span class="theme-toggle-moon">☾</span>
              </span>
              <span class="theme-toggle-thumb" aria-hidden="true"></span>
            </button>
          </div>
        </div>
      </header>

      <main class="home-screen">
        <section class="hero" aria-labelledby="page-title">
          <div class="wrap hero-grid">
            <div class="hero-copy">
              <div class="audience-row entrance entrance-1">
                <span class="audience-label">I am a</span>
                <div class="audience-switcher" role="group" aria-label="Choose your Promptendium level">
                  <button class="audience-option" type="button" data-audience-level="children" aria-pressed="false">Child</button>
                  <button class="audience-option" type="button" data-audience-level="everyday" aria-pressed="true">Non-technical person</button>
                  <button class="audience-option" type="button" data-audience-level="technical" aria-pressed="false">Technical person</button>
                </div>
              </div>

              <div class="message-stack">
                <div class="copy-slot entrance entrance-2">
                  <div class="eyebrow level-copy" data-level="children">AI that makes sense</div>
                  <div class="eyebrow level-copy" data-level="everyday">Practical AI prompting</div>
                  <div class="eyebrow level-copy" data-level="technical">Prompt engineering workspace</div>
                </div>

                <div class="copy-slot entrance entrance-3">
                  <h1 id="page-title" class="level-copy" data-level="children">Ask better.<br />Learn faster.</h1>
                  <h1 class="level-copy" data-level="everyday">Less guessing.<br />Better prompting.</h1>
                  <h1 class="level-copy" data-level="technical">Prompt with precision.<br />Control the output.</h1>
                </div>

                <div class="copy-slot entrance entrance-4">
                  <p class="lede level-copy" data-level="children">
                    Friendly prompts, clear explanations and useful ideas for school, creativity and learning.
                  </p>
                  <p class="lede level-copy" data-level="everyday">
                    Everything you need to get more from AI — without the jargon.
                  </p>
                  <p class="lede level-copy" data-level="technical">
                    Structured prompting, constraints, schemas and model-aware techniques for repeatable results.
                  </p>
                </div>

                <div class="product-pills entrance entrance-5" aria-label="Promptendium tools">
                  <span class="level-copy" data-level="children">Learn with AI</span>
                  <span class="level-copy" data-level="children">Create something</span>
                  <span class="level-copy" data-level="children">Build a prompt</span>

                  <span class="level-copy" data-level="everyday">Prompt Dictionary</span>
                  <span class="level-copy" data-level="everyday">Practical Guides</span>
                  <span class="level-copy" data-level="everyday">Prompt Generator</span>

                  <span class="level-copy" data-level="technical">Prompt patterns</span>
                  <span class="level-copy" data-level="technical">Model behaviour</span>
                  <span class="level-copy" data-level="technical">Schema builder</span>
                </div>
              </div>

              <div class="copy-slot entrance entrance-5">
                <div class="hero-note level-copy" data-level="children">Simple language. Safe examples. Easy to explore.</div>
                <div class="hero-note level-copy" data-level="everyday">Clear explanations. Practical prompts. No hype.</div>
                <div class="hero-note level-copy" data-level="technical">Precise methods. Explicit constraints. Reproducible outputs.</div>
              </div>
            </div>

            <div class="product-stage entrance stage-entrance" aria-label="Promptendium experience preview">
              <div class="stage-glow" aria-hidden="true"></div>

              <div class="level-scene child-scene" data-scene="children">
                <div class="child-topline">
                  <span class="child-badge">Promptendium for learners</span>
                  <span class="child-stars" aria-hidden="true">✦ ★ ✦</span>
                </div>
                <h2 class="child-heading">What would you like to discover?</h2>
                <p class="child-sub">Turn a question, homework topic or idea into a better prompt — then understand the answer.</p>
                <div class="child-search">
                  <span class="child-search-icon" aria-hidden="true">✦</span>
                  <span class="child-query dynamic-query" data-query-level="children">Explain photosynthesis like I’m 10</span>
                  <span class="typing-cursor" aria-hidden="true"></span>
                </div>
                <div class="child-cards">
                  <div class="child-card">
                    <div class="child-icon">?</div>
                    <strong>Ask</strong>
                    <span>Turn a question into a clear AI prompt.</span>
                  </div>
                  <div class="child-card">
                    <div class="child-icon">★</div>
                    <strong>Learn</strong>
                    <span>Get simple explanations with examples.</span>
                  </div>
                  <div class="child-card">
                    <div class="child-icon">✦</div>
                    <strong>Create</strong>
                    <span>Stories, quizzes, ideas and projects.</span>
                  </div>
                </div>
              </div>

              <div class="level-scene everyday-scene" data-scene="everyday">
                <div class="everyday-top" aria-hidden="true">
                  <span class="everyday-dot"></span><span class="everyday-dot"></span><span class="everyday-dot"></span>
                </div>
                <div class="everyday-label">Promptendium</div>
                <h2 class="everyday-title">Find the right prompt faster.</h2>
                <div class="everyday-search">
                  <span class="everyday-query dynamic-query" data-query-level="everyday">Search prompts, guides and terms…</span>
                  <span class="typing-cursor" aria-hidden="true"></span>
                  <span class="everyday-key">⌘ K</span>
                </div>
                <div class="everyday-cards">
                  <div class="everyday-card primary">
                    <strong>Prompt Dictionary</strong>
                    <span>Browse practical prompts by task, category or letter.</span>
                    <div class="everyday-purple"></div>
                  </div>
                  <div class="everyday-card">
                    <strong>Prompting Guides</strong>
                    <span>Learn the ideas that make prompts easier to write and improve.</span>
                  </div>
                  <div class="everyday-card">
                    <strong>AI terminology</strong>
                    <span>Plain-English definitions for the terms you actually see.</span>
                  </div>
                  <div class="everyday-card">
                    <strong>Prompt Generator</strong>
                    <span>A guided tool for building prompts around your task.</span>
                  </div>
                </div>
              </div>

              <div class="level-scene technical-scene" data-scene="technical">
                <div class="tech-toolbar">
                  <span class="tech-path">promptendium / workspace / prompt</span>
                  <span class="tech-status">validated</span>
                </div>
                <div class="tech-body">
                  <div class="tech-editor">
                    <div class="tech-kicker">Prompt specification</div>
                    <h2 class="tech-heading">Design for predictable output.</h2>
                    <div class="tech-query">
                      <span class="dynamic-query" data-query-level="technical">Create a constrained JSON extraction prompt</span><span class="typing-cursor" aria-hidden="true"></span>
                    </div>
                    <div class="tech-code" aria-hidden="true">
                      <div class="tech-line"><span class="tech-ln">01</span><span><span class="tech-keyword">role</span>: <span class="tech-string">"extractor"</span></span></div>
                      <div class="tech-line"><span class="tech-ln">02</span><span><span class="tech-keyword">output</span>: <span class="tech-string">"json_schema"</span></span></div>
                      <div class="tech-line"><span class="tech-ln">03</span><span><span class="tech-keyword">temperature</span>: <span class="tech-value">0.2</span></span></div>
                      <div class="tech-line"><span class="tech-ln">04</span><span><span class="tech-keyword">constraints</span>: <span class="tech-dim">[strict, cited]</span></span></div>
                      <div class="tech-line"><span class="tech-ln">05</span><span><span class="tech-keyword">fallback</span>: <span class="tech-string">"insufficient_context"</span></span></div>
                    </div>
                  </div>
                  <aside class="tech-panel">
                    <div class="tech-panel-title">Run profile</div>
                    <div class="tech-metric"><span>Mode</span><strong>Structured</strong></div>
                    <div class="tech-metric"><span>Schema</span><strong>Strict</strong></div>
                    <div class="tech-metric"><span>Examples</span><strong>2-shot</strong></div>
                    <div class="tech-metric"><span>Risk flags</span><strong>Enabled</strong></div>
                    <div class="tech-schema">
                      <div class="tech-schema-title">Output contract</div>
                      <div class="tech-schema-row"><span>answer</span><strong>string</strong></div>
                      <div class="tech-schema-row"><span>confidence</span><strong>number</strong></div>
                      <div class="tech-schema-row"><span>sources</span><strong>array</strong></div>
                    </div>
                  </aside>
                </div>
              </div>
            </div>
          </div>
        </section>
      </main>
    </div>

    <script is:inline>
      (() => {
        const root = document.documentElement;
        const buttons = Array.from(document.querySelectorAll('[data-audience-level]'));
        const validLevels = ['children', 'everyday', 'technical'];

        const applyLevel = (level, save = true, animate = true) => {
          const nextLevel = validLevels.includes(level) ? level : 'everyday';
          root.dataset.level = nextLevel;

          buttons.forEach((button) => {
            button.setAttribute('aria-pressed', String(button.dataset.audienceLevel === nextLevel));
          });

          if (save) {
            try {
              localStorage.setItem('promptendium-level', nextLevel);
            } catch {}
          }

          if (animate) {
            document.querySelectorAll(`.level-copy[data-level="${nextLevel}"], .level-scene[data-scene="${nextLevel}"]`).forEach((node) => {
              node.classList.remove('audience-transition');
              void node.offsetWidth;
              node.classList.add('audience-transition');
              window.setTimeout(() => node.classList.remove('audience-transition'), 900);
            });
          }

          window.dispatchEvent(new CustomEvent('promptendium-level-change', { detail: { level: nextLevel } }));
        };

        buttons.forEach((button) => {
          button.addEventListener('click', () => applyLevel(button.dataset.audienceLevel));
        });

        applyLevel(root.dataset.level || 'everyday', false, false);
      })();
    </script>

    <script is:inline>
      (() => {
        const root = document.documentElement;
        const toggle = document.getElementById('themeToggle');
        const themeColor = document.getElementById('themeColor');

        if (!toggle) return;

        const applyTheme = (theme, save = true) => {
          const dark = theme === 'dark';
          root.dataset.theme = dark ? 'dark' : 'light';
          toggle.setAttribute('aria-pressed', String(dark));
          toggle.setAttribute('aria-label', dark ? 'Switch to light mode' : 'Switch to dark mode');
          if (themeColor) themeColor.setAttribute('content', dark ? '#0F0F10' : '#F7F6F2');

          if (save) {
            try {
              localStorage.setItem('promptendium-theme', dark ? 'dark' : 'light');
            } catch {}
          }
        };

        applyTheme(root.dataset.theme || 'light', false);

        toggle.addEventListener('click', () => {
          applyTheme(root.dataset.theme === 'dark' ? 'light' : 'dark');
        });
      })();
    </script>

    <script is:inline>
      (() => {
        const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        const phrasesByLevel = {
          children: [
            'Explain photosynthesis like I’m 10',
            'Help me make a volcano project',
            'Quiz me on the solar system',
            'Write a funny story about a robot'
          ],
          everyday: [
            'Search prompts, guides and terms…',
            'Write a professional follow-up email',
            'Summarise these meeting notes',
            'Create a project planning prompt'
          ],
          technical: [
            'Create a constrained JSON extraction prompt',
            'Design a retrieval-grounded system prompt',
            'Compare few-shot prompting strategies',
            'Specify a strict structured output contract'
          ]
        };

        let timer = null;
        let query = null;
        let phrases = phrasesByLevel.everyday;
        let phraseIndex = 0;
        let charIndex = 0;
        let deleting = true;

        const schedule = (fn, delay) => {
          timer = window.setTimeout(fn, delay);
        };

        const tick = () => {
          if (!query) return;
          const phrase = phrases[phraseIndex];

          if (deleting) {
            charIndex = Math.max(0, charIndex - 1);
            query.textContent = phrase.slice(0, charIndex);

            if (charIndex === 0) {
              deleting = false;
              phraseIndex = (phraseIndex + 1) % phrases.length;
              schedule(tick, 850);
              return;
            }

            schedule(tick, 65);
            return;
          }

          const nextPhrase = phrases[phraseIndex];
          charIndex = Math.min(nextPhrase.length, charIndex + 1);
          query.textContent = nextPhrase.slice(0, charIndex);

          if (charIndex === nextPhrase.length) {
            deleting = true;
            schedule(tick, 3900);
            return;
          }

          schedule(tick, 105);
        };

        const restart = (level) => {
          if (timer) window.clearTimeout(timer);
          phrases = phrasesByLevel[level] || phrasesByLevel.everyday;
          query = document.querySelector(`.dynamic-query[data-query-level="${level}"]`);
          phraseIndex = 0;
          charIndex = phrases[0].length;
          deleting = true;
          if (query) query.textContent = phrases[0];

          if (!reduceMotion && query) schedule(tick, 4200);
        };

        restart(document.documentElement.dataset.level || 'everyday');

        window.addEventListener('promptendium-level-change', (event) => {
          restart(event.detail?.level || 'everyday');
        });
      })();
    </script>
  </body>
</html>
