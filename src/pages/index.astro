---
const dictionary = [
  ['System prompt', 'Instructions that establish an AI assistant’s role, behaviour and boundaries.'],
  ['Context window', 'The amount of information a model can consider at one time.'],
  ['Few-shot prompting', 'Guiding a model by giving it a small number of examples.'],
  ['Prompt injection', 'Instructions intended to manipulate or override an AI system’s intended rules.'],
  ['Tokens', 'The chunks of text models process when reading and generating language.'],
  ['Temperature', 'A model setting associated with variation and predictability in generated output.'],
  ['Hallucination', 'When an AI produces information that appears plausible but is incorrect.'],
  ['Zero-shot prompting', 'Asking a model to perform a task without providing worked examples first.'],
];

const letters = 'ABCDEFGHIJKLMNOPQRSTUVWXYZ'.split('');
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <title>AI Prompt Dictionary & Guides | Promptendium</title>
    <meta
      name="description"
      content="Promptendium explains AI prompting in plain English. Search prompt terminology, learn prompting techniques and use practical guides to write better AI prompts."
    />
    <meta name="theme-color" content="#F7F6F2" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content="AI Prompt Dictionary & Guides | Promptendium" />
    <meta
      property="og:description"
      content="Understand AI terminology, learn how prompting works and write clearer, more effective prompts with Promptendium."
    />
    <meta name="twitter:card" content="summary" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <style is:global>
      :root {
        --paper:#F7F6F2;
        --paper-2:#FCFBF8;
        --ink:#151515;
        --muted:#706E68;
        --line:#DCD9D1;
        --violet:#6D4AFF;
        --violet-dark:#5637DB;
        --violet-soft:#ECE8FF;
        --radius:20px;
        --max:1220px;
        --shadow:0 18px 60px rgba(21,21,21,.08);
      }
      * { box-sizing:border-box; }
      html { scroll-behavior:smooth; }
      body {
        margin:0;
        color:var(--ink);
        background:var(--paper);
        font-family:Inter,ui-sans-serif,system-ui,-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif;
        line-height:1.55;
        -webkit-font-smoothing:antialiased;
      }
      a { color:inherit; text-decoration:none; }
      button,input { font:inherit; }
      img { display:block; max-width:100%; }
      .wrap { width:min(calc(100% - 38px),var(--max)); margin-inline:auto; }
      .site-header {
        position:sticky; top:0; z-index:40;
        background:rgba(247,246,242,.9);
        backdrop-filter:blur(18px);
        border-bottom:1px solid rgba(220,217,209,.85);
      }
      .header-inner { min-height:78px; display:flex; align-items:center; justify-content:space-between; gap:24px; }
      .header-logo { width:300px; display:flex; align-items:center; }
      .header-logo img { width:100%; height:auto; }
      .nav { display:flex; align-items:center; gap:28px; font-size:14px; font-weight:700; color:#3D3A36; }
      .nav a:hover { color:var(--violet); }
      .nav-cta { border:1px solid var(--ink); border-radius:999px; padding:10px 16px; background:var(--ink); color:#fff!important; }
      .hero { position:relative; padding:86px 0 70px; overflow:hidden; }
      .hero::after {
        content:""; position:absolute; width:520px; height:520px; border-radius:50%; right:-170px; top:-140px;
        background:radial-gradient(circle,rgba(109,74,255,.14),rgba(109,74,255,0) 68%); pointer-events:none;
      }
      .hero-grid { display:grid; grid-template-columns:minmax(0,1.4fr) minmax(300px,.65fr); gap:64px; align-items:center; position:relative; z-index:1; }
      .eyebrow { display:inline-flex; align-items:center; gap:9px; border:1px solid var(--line); border-radius:999px; background:rgba(255,255,255,.55); padding:8px 12px; color:#4B4944; font-weight:750; font-size:13px; }
      .eyebrow-dot { width:7px; height:7px; border-radius:50%; background:var(--violet); }
      h1,h2,h3 { margin:0; font-family:Georgia,"Times New Roman",serif; font-weight:500; letter-spacing:-.04em; }
      h1 { margin-top:24px; font-size:clamp(54px,7.2vw,96px); line-height:.94; max-width:860px; }
      .hero-copy { max-width:710px; font-size:clamp(18px,2vw,23px); color:var(--muted); margin:26px 0 32px; }
      .search-box { display:flex; align-items:center; gap:8px; max-width:790px; background:#fff; border:1px solid var(--line); padding:9px; border-radius:18px; box-shadow:var(--shadow); }
      .search-icon { width:46px; height:46px; display:grid; place-items:center; border-radius:13px; background:#F0EEE8; font-size:20px; flex:0 0 auto; }
      .search-box input { flex:1; min-width:0; border:0; outline:0; background:transparent; padding:0 6px; color:var(--ink); font-size:16px; }
      .search-box button { border:0; cursor:pointer; border-radius:12px; background:var(--violet); color:#fff; font-weight:800; padding:14px 18px; }
      .search-box button:hover { background:var(--violet-dark); }
      #searchResults { display:none; max-width:790px; margin-top:10px; background:#fff; border:1px solid var(--line); border-radius:15px; padding:7px; box-shadow:var(--shadow); }
      .result { display:block; border-radius:10px; padding:11px 12px; font-size:14px; }
      .result:hover { background:#F3F1EB; }
      .result strong { display:block; font-size:15px; margin-bottom:2px; }
      .result span { color:var(--muted); }
      .hero-links { display:flex; gap:18px; flex-wrap:wrap; margin-top:18px; color:#57544E; font-size:14px; font-weight:650; }
      .hero-links a,.text-link { text-decoration:underline; text-underline-offset:4px; text-decoration-color:#BEB9AD; }
      .definition-card { background:var(--ink); color:#fff; border-radius:26px; padding:30px; box-shadow:0 28px 80px rgba(21,21,21,.16); min-height:390px; position:relative; overflow:hidden; }
      .definition-card::after { content:"P"; position:absolute; right:-2px; bottom:-66px; font-family:Georgia,serif; font-size:250px; color:rgba(255,255,255,.035); }
      .mini-label { text-transform:uppercase; letter-spacing:.12em; font-size:11px; font-weight:850; color:#AAA0FF; }
      .definition-card h2 { font-size:44px; margin:62px 0 14px; line-height:1; }
      .definition-card p { margin:0; color:#C9C6C0; font-size:15px; max-width:300px; }
      .definition-card .card-link { position:absolute; left:30px; bottom:28px; color:#fff; font-size:14px; font-weight:750; z-index:1; }
      .az-strip { border-top:1px solid var(--line); border-bottom:1px solid var(--line); background:var(--paper-2); }
      .az-inner { min-height:92px; display:grid; grid-template-columns:auto 1fr; gap:28px; align-items:center; }
      .az-label { font-size:13px; font-weight:850; text-transform:uppercase; letter-spacing:.1em; }
      .letters { display:grid; grid-template-columns:repeat(26,1fr); gap:3px; }
      .letters a { height:36px; display:grid; place-items:center; border-radius:8px; color:#5D5A54; font-size:13px; font-weight:750; }
      .letters a:hover { background:var(--violet-soft); color:var(--violet-dark); }
      section { padding:78px 0; }
      .section-head { display:grid; grid-template-columns:1fr minmax(280px,430px); gap:40px; align-items:end; margin-bottom:30px; }
      .kicker { color:var(--violet); text-transform:uppercase; letter-spacing:.12em; font-size:11px; font-weight:900; margin-bottom:9px; }
      h2 { font-size:clamp(36px,4.5vw,58px); line-height:1.02; }
      .section-head p { color:var(--muted); margin:0; font-size:15px; }
      .term-grid { display:grid; grid-template-columns:repeat(4,1fr); gap:12px; }
      .term-card { min-height:172px; padding:22px; border:1px solid var(--line); border-radius:17px; background:rgba(255,255,255,.5); display:flex; flex-direction:column; transition:.18s ease; }
      .term-card:hover { transform:translateY(-3px); border-color:#BAB1E9; background:#fff; }
      .term-top { display:flex; justify-content:space-between; gap:12px; font-weight:850; }
      .term-arrow { color:var(--violet); }
      .term-card p { color:var(--muted); font-size:14px; margin:auto 0 0; }
      .learn-section { background:var(--ink); color:#fff; }
      .learn-section .kicker { color:#AB9EFF; }
      .learn-section .section-head p { color:#AAA6A0; }
      .learning-path { display:grid; grid-template-columns:repeat(3,1fr); gap:13px; }
      .path-card { min-height:300px; border:1px solid #373737; background:#1D1D1D; border-radius:19px; padding:28px; display:flex; flex-direction:column; }
      .step { display:flex; justify-content:space-between; color:#A99AFF; font-family:Georgia,serif; font-size:18px; }
      .path-card h3 { margin:auto 0 14px; font-size:31px; line-height:1.05; }
      .path-card p { color:#B8B4AE; margin:0; font-size:14px; }
      .path-link { margin-top:22px; font-weight:750; font-size:13px; color:#D6D2CC; }
      .explain-panel { display:grid; grid-template-columns:.85fr 1.15fr; gap:14px; }
      .explain-intro { border:1px solid var(--line); border-radius:22px; background:#fff; padding:32px; }
      .mark-large { width:68px; height:68px; object-fit:contain; margin-bottom:54px; }
      .explain-intro h3 { font-size:38px; line-height:1.05; margin-bottom:14px; }
      .explain-intro p { color:var(--muted); margin:0; max-width:450px; }
      .explain-grid { display:grid; grid-template-columns:1fr 1fr; gap:12px; }
      .explain-card { border:1px solid var(--line); border-radius:18px; background:var(--paper-2); padding:24px; min-height:190px; }
      .explain-card .num { color:var(--violet); font-weight:900; font-size:12px; letter-spacing:.08em; }
      .explain-card h3 { font-family:inherit; font-size:16px; letter-spacing:0; font-weight:850; margin:32px 0 8px; }
      .explain-card p { margin:0; color:var(--muted); font-size:14px; }
      .guide-grid { display:grid; grid-template-columns:1.35fr 1fr 1fr; gap:13px; }
      .guide { min-height:285px; border:1px solid var(--line); border-radius:19px; padding:26px; background:rgba(255,255,255,.55); display:flex; flex-direction:column; }
      .guide.featured { min-height:380px; background:var(--violet); color:#fff; border-color:var(--violet); }
      .guide-tag { text-transform:uppercase; letter-spacing:.1em; font-size:11px; font-weight:900; opacity:.72; }
      .guide h3 { margin:auto 0 12px; font-size:30px; line-height:1.05; }
      .guide.featured h3 { font-size:43px; max-width:470px; }
      .guide p { margin:0; color:var(--muted); font-size:14px; }
      .guide.featured p { color:rgba(255,255,255,.78); }
      .prompt-demo { border:1px solid var(--line); border-radius:24px; padding:16px; background:#fff; box-shadow:var(--shadow); display:grid; grid-template-columns:1fr 66px 1fr; gap:14px; align-items:stretch; }
      .prompt-box { border-radius:17px; background:#F0EEE8; padding:25px; min-height:220px; }
      .prompt-box.better { background:var(--violet-soft); }
      .prompt-label { font-size:11px; text-transform:uppercase; letter-spacing:.12em; font-weight:900; color:#77736C; }
      blockquote { margin:40px 0 0; font-family:Georgia,serif; font-size:21px; line-height:1.45; }
      .prompt-arrow { display:grid; place-items:center; color:var(--violet); font-size:30px; }
      .trust { border-top:1px solid var(--ink); border-bottom:1px solid var(--ink); padding:50px 0; display:grid; grid-template-columns:.75fr 1.25fr; gap:70px; }
      .trust h2 { font-size:clamp(38px,5vw,62px); }
      .trust-copy p { margin:0 0 16px; color:#49463F; font-family:Georgia,serif; font-size:23px; line-height:1.45; }
      .text-link { color:#5C5851; font-size:14px; font-weight:750; }
      footer { padding:32px 0 45px; }
      .footer-inner { display:flex; justify-content:space-between; align-items:center; gap:24px; flex-wrap:wrap; color:#6D6962; font-size:13px; }
      .footer-brand { display:flex; align-items:center; gap:10px; color:var(--ink); font-weight:850; }
      .footer-brand img { width:36px; height:36px; object-fit:contain; }
      .footer-links { display:flex; gap:20px; flex-wrap:wrap; }
      @media (max-width:980px) {
        .nav a:not(.nav-cta) { display:none; }
        .header-logo { width:245px; }
        .hero-grid { grid-template-columns:1fr; }
        .definition-card { min-height:300px; }
        .definition-card h2 { margin-top:42px; }
        .letters { grid-template-columns:repeat(13,1fr); }
        .term-grid { grid-template-columns:repeat(2,1fr); }
        .learning-path,.guide-grid { grid-template-columns:1fr; }
        .guide.featured { min-height:300px; }
        .explain-panel,.trust { grid-template-columns:1fr; }
      }
      @media (max-width:650px) {
        .wrap { width:min(calc(100% - 24px),var(--max)); }
        .header-inner { min-height:67px; }
        .header-logo { width:205px; }
        .nav-cta { padding:9px 12px; font-size:12px; }
        .hero { padding:56px 0 54px; }
        h1 { font-size:55px; }
        .search-box { flex-wrap:wrap; }
        .search-icon { display:none; }
        .search-box input { min-height:46px; }
        .search-box button { width:100%; }
        .az-inner { grid-template-columns:1fr; padding:18px 0; gap:8px; }
        .letters { grid-template-columns:repeat(9,1fr); }
        section { padding:58px 0; }
        .section-head { grid-template-columns:1fr; gap:14px; }
        .term-grid,.explain-grid { grid-template-columns:1fr; }
        .prompt-demo { grid-template-columns:1fr; }
        .prompt-arrow { transform:rotate(90deg); min-height:36px; }
        blockquote { margin-top:25px; font-size:19px; }
        .trust { gap:25px; }
        .trust-copy p { font-size:20px; }
      }
    </style>
  </head>
  <body>
    <header class="site-header">
      <div class="wrap header-inner">
        <a href="#top" class="header-logo" aria-label="Promptendium home">
          <img
            src="/brand/promptendium-logo.webp"
            alt="Promptendium — The reference for better AI prompts."
            width="1256"
            height="303"
          />
        </a>
        <nav class="nav" aria-label="Primary navigation">
          <a href="/dictionary/">Dictionary</a>
          <a href="#learn">Learn</a>
          <a href="#guides">Guides</a>
          <a href="#examples">Prompt Examples</a>
          <a href="#about" class="nav-cta">About</a>
        </nav>
      </div>
    </header>

    <main id="top">
      <section class="hero">
        <div class="wrap hero-grid">
          <div>
            <div class="eyebrow"><span class="eyebrow-dot"></span> Independent AI prompting reference</div>
            <h1>The AI Prompt Dictionary &amp; Guide.</h1>
            <p class="hero-copy">
              Understand AI terminology, learn how prompting works and write clearer, more effective prompts — without unnecessary jargon.
            </p>

            <form class="search-box" role="search" aria-label="Search the AI prompt dictionary">
              <div class="search-icon" aria-hidden="true">⌕</div>
              <input id="searchInput" aria-label="Search the AI prompt dictionary" placeholder="Search: system prompt, context window, tokens…" />
              <button type="submit">Search dictionary</button>
            </form>
            <div id="searchResults" aria-live="polite"></div>

            <div class="hero-links">
              <a href="/dictionary/">Browse the prompt dictionary A–Z →</a>
              <a href="#learn">Start with Prompting 101 →</a>
            </div>
          </div>

          <aside class="definition-card" aria-label="Featured definition">
            <div class="mini-label">Featured definition</div>
            <h2>Context window</h2>
            <p>The amount of information an AI model can consider at one time when producing its response.</p>
            <a class="card-link" href="#dictionary">Explore popular definitions →</a>
          </aside>
        </div>
      </section>

      <div class="az-strip" id="az">
        <div class="wrap az-inner">
          <div class="az-label">Dictionary A–Z</div>
          <div class="letters" aria-label="Browse dictionary by letter">
            {letters.map((letter) => <a href={`/dictionary/#${letter}`} aria-label={`Browse prompts beginning with ${letter}`}>{letter}</a>)}
          </div>
        </div>
      </div>

      <section id="dictionary">
        <div class="wrap">
          <div class="section-head">
            <div>
              <div class="kicker">Popular definitions</div>
              <h2>Learn the language of AI prompting.</h2>
            </div>
            <p>Clear explanations of the terms you see in AI tools, prompt guides and model documentation.</p>
          </div>

          <div class="term-grid">
            {dictionary.map(([term, description]) => (
              <article class="term-card">
                <div class="term-top"><span>{term}</span><span class="term-arrow" aria-hidden="true">↗</span></div>
                <p>{description}</p>
              </article>
            ))}
          </div>
        </div>
      </section>

      <section class="learn-section" id="learn">
        <div class="wrap">
          <div class="section-head">
            <div>
              <div class="kicker">Learn prompting</div>
              <h2>A clear path from beginner to better prompts.</h2>
            </div>
            <p>Learn the foundations in order, then move into techniques only when they become useful.</p>
          </div>

          <div class="learning-path">
            <article class="path-card">
              <div class="step"><span>01</span><span>Start here</span></div>
              <h3>Prompting fundamentals</h3>
              <p>What a prompt is, how models interpret instructions and the building blocks of a useful request.</p>
              <div class="path-link">Core learning path</div>
            </article>
            <article class="path-card">
              <div class="step"><span>02</span><span>Improve</span></div>
              <h3>Writing better prompts</h3>
              <p>Use context, constraints, examples and clear outputs to make your instructions easier to follow.</p>
              <div class="path-link">Practical framework</div>
            </article>
            <article class="path-card">
              <div class="step"><span>03</span><span>Go deeper</span></div>
              <h3>Prompting techniques</h3>
              <p>Understand zero-shot, few-shot, structured prompting and other techniques without turning them into tricks.</p>
              <div class="path-link">Advanced concepts</div>
            </article>
          </div>
        </div>
      </section>

      <section>
        <div class="wrap">
          <div class="section-head">
            <div>
              <div class="kicker">How we explain things</div>
              <h2>Useful definitions, not dictionary filler.</h2>
            </div>
            <p>Each important term should help you understand the concept and know what to do with it.</p>
          </div>

          <div class="explain-panel">
            <div class="explain-intro">
              <img class="mark-large" src="/brand/promptendium-mark.webp" alt="" width="610" height="623" />
              <h3>One term. Four useful answers.</h3>
              <p>Promptendium definitions are designed to move from recognition to practical understanding.</p>
            </div>
            <div class="explain-grid">
              <article class="explain-card"><div class="num">01</div><h3>Plain-English definition</h3><p>A concise explanation that answers “what is this?” immediately.</p></article>
              <article class="explain-card"><div class="num">02</div><h3>Why it matters</h3><p>The practical reason the concept affects prompting or AI output.</p></article>
              <article class="explain-card"><div class="num">03</div><h3>Real example</h3><p>A concrete example showing how the term appears in an actual prompting situation.</p></article>
              <article class="explain-card"><div class="num">04</div><h3>Related concepts</h3><p>Clear links to the next terms or guides that genuinely help you continue learning.</p></article>
            </div>
          </div>
        </div>
      </section>

      <section id="guides">
        <div class="wrap">
          <div class="section-head">
            <div>
              <div class="kicker">Practical guides</div>
              <h2>Learn by doing.</h2>
            </div>
            <p>Focused guides for common prompting questions, written to help you complete a real task rather than chase a keyword.</p>
          </div>

          <div class="guide-grid">
            <article class="guide featured">
              <div class="guide-tag">Start here · Core guide</div>
              <h3>How to write a good AI prompt</h3>
              <p>A practical framework for turning a vague request into clear instructions an AI model can follow.</p>
            </article>
            <article class="guide">
              <div class="guide-tag">Explainer</div>
              <h3>What is a system prompt?</h3>
              <p>Understand where system prompts sit, what they control and how they differ from user prompts.</p>
            </article>
            <article class="guide">
              <div class="guide-tag">Comparison</div>
              <h3>Zero-shot vs few-shot prompting</h3>
              <p>When a direct instruction is enough — and when examples give the model a better steer.</p>
            </article>
          </div>
        </div>
      </section>

      <section id="examples">
        <div class="wrap">
          <div class="section-head">
            <div>
              <div class="kicker">Prompt examples</div>
              <h2>See why one prompt works better.</h2>
            </div>
            <p>Prompt examples should teach a reusable principle rather than give you something to copy without understanding.</p>
          </div>

          <div class="prompt-demo">
            <div class="prompt-box">
              <div class="prompt-label">Basic prompt</div>
              <blockquote>“Write me an email asking for a meeting.”</blockquote>
            </div>
            <div class="prompt-arrow" aria-hidden="true">→</div>
            <div class="prompt-box better">
              <div class="prompt-label">Clearer prompt</div>
              <blockquote>“Write a concise, professional email requesting a 30-minute meeting next week to discuss the Q3 project plan. Keep it friendly and under 120 words.”</blockquote>
            </div>
          </div>
        </div>
      </section>

      <section id="about">
        <div class="wrap trust">
          <div>
            <div class="kicker">About Promptendium</div>
            <h2>AI prompting, explained clearly.</h2>
          </div>
          <div class="trust-copy">
            <p>Promptendium is an independent reference for understanding AI prompting terminology, techniques and practical ways to communicate more clearly with AI.</p>
            <a class="text-link" href="#top">Back to the top →</a>
          </div>
        </div>
      </section>
    </main>

    <footer>
      <div class="wrap footer-inner">
        <div class="footer-brand">
          <img src="/brand/promptendium-mark.webp" alt="" width="610" height="623" />
          <span>Promptendium</span>
        </div>
        <div class="footer-links">
          <a href="/dictionary/">Dictionary</a>
          <a href="#learn">Learn</a>
          <a href="#guides">Guides</a>
          <a href="#about">About</a>
        </div>
        <div>© 2026 Promptendium</div>
      </div>
    </footer>

    <script define:vars={{ dictionary }}>
      const form = document.querySelector('.search-box');
      const input = document.querySelector('#searchInput');
      const output = document.querySelector('#searchResults');

      form?.addEventListener('submit', (event) => {
        event.preventDefault();
        if (!(input instanceof HTMLInputElement) || !(output instanceof HTMLElement)) return;

        const query = input.value.trim().toLowerCase();
        const matches = query
          ? dictionary.filter((item) => `${item[0]} ${item[1]}`.toLowerCase().includes(query))
          : dictionary.slice(0, 4);

        output.replaceChildren();

        if (!matches.length) {
          const empty = document.createElement('div');
          empty.className = 'result';
          const strong = document.createElement('strong');
          strong.textContent = 'No prototype result yet';
          const text = document.createElement('span');
          text.textContent = 'Try “system prompt”, “tokens” or “context window”.';
          empty.append(strong, text);
          output.append(empty);
        } else {
          for (const [name, description] of matches) {
            const result = document.createElement('a');
            result.className = 'result';
            result.href = '#dictionary';
            const strong = document.createElement('strong');
            strong.textContent = name;
            const text = document.createElement('span');
            text.textContent = description;
            result.append(strong, text);
            output.append(result);
          }
        }

        output.style.display = 'block';
      });
    </script>
  </body>
</html>
