---
import '../styles/global.css';
import '../styles/animation-slow.css';
import '../styles/theme.css';
import '../styles/audience.css';

const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const logo = `${base}brand/promptendium-logo.webp`;
const favicon = `${base}favicon.png`;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>Promptendium — Less guessing. Better prompting.</title>
    <meta name="description" content="Practical AI prompts and guidance for children, everyday users and technical users." />
    <meta name="theme-color" content="#F7F6F2" id="themeColor" />
    <link rel="icon" type="image/png" href={favicon} />
    <script is:inline>
      (() => {
        try {
          const savedTheme = localStorage.getItem('promptendium-theme');
          const theme = savedTheme || (window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
          document.documentElement.dataset.theme = theme;

          const savedLevel = localStorage.getItem('promptendium-level');
          document.documentElement.dataset.level = ['children', 'everyday', 'technical'].includes(savedLevel) ? savedLevel : 'everyday';
        } catch {
          document.documentElement.dataset.theme = 'light';
          document.documentElement.dataset.level = 'everyday';
        }
      })();
    </script>
  </head>
  <body>
    <div class="page-shell">
      <header class="site-header entrance header-entrance">
        <div class="wrap header-inner">
          <a class="brand" href={base} aria-label="Promptendium home">
            <img src={logo} alt="Promptendium — The reference for better AI prompts." />
          </a>

          <div class="header-actions">
            <button class="theme-toggle" id="themeToggle" type="button" aria-label="Switch to dark mode" aria-pressed="false">
              <span class="theme-toggle-track" aria-hidden="true">
                <span class="theme-toggle-sun">☀</span>
                <span class="theme-toggle-moon">☾</span>
              </span>
              <span class="theme-toggle-thumb" aria-hidden="true"></span>
            </button>
          </div>
        </div>
      </header>

      <main class="home-screen">
        <section class="hero" aria-labelledby="page-title">
          <div class="wrap hero-grid">
            <div class="hero-copy">
              <div class="audience-row entrance entrance-1">
                <span class="audience-label">I am a</span>
                <div class="audience-switcher" role="group" aria-label="Choose your Promptendium level">
                  <button class="audience-option" type="button" data-audience-level="children" aria-pressed="false">Child</button>
                  <button class="audience-option" type="button" data-audience-level="everyday" aria-pressed="true">Non-technical person</button>
                  <button class="audience-option" type="button" data-audience-level="technical" aria-pressed="false">Technical person</button>
                </div>
              </div>

              <div class="copy-slot entrance entrance-2">
                <div class="eyebrow level-copy" data-level="children">AI prompting made simple</div>
                <div class="eyebrow level-copy" data-level="everyday">Practical AI prompting</div>
                <div class="eyebrow level-copy" data-level="technical">Technical prompting reference</div>
              </div>

              <h1 id="page-title" class="entrance entrance-3">Less guessing.<br />Better prompting.</h1>

              <div class="copy-slot entrance entrance-4">
                <p class="lede level-copy" data-level="children">
                  Simple prompts and easy explanations to help younger users get better results from AI.
                </p>
                <p class="lede level-copy" data-level="everyday">
                  Everything you need to get more from AI — without the jargon.
                </p>
                <p class="lede level-copy" data-level="technical">
                  Structured prompting, model behaviour and practical techniques for more controlled AI output.
                </p>
              </div>

              <div class="product-pills entrance entrance-5" aria-label="Promptendium products">
                <span>Prompt Dictionary</span>
                <span>Practical Guides</span>
                <span>Prompt Generator</span>
              </div>

              <div class="copy-slot entrance entrance-5">
                <div class="hero-note level-copy" data-level="children">Simple language. Clear examples. Easy to try.</div>
                <div class="hero-note level-copy" data-level="everyday">Clear explanations. Practical prompts. No hype.</div>
                <div class="hero-note level-copy" data-level="technical">Precise methods. Model-aware guidance. More control.</div>
              </div>
            </div>

            <div class="product-stage entrance stage-entrance" aria-label="Promptendium product preview">
              <div class="stage-glow" aria-hidden="true"></div>
              <div class="mock-window">
                <div class="mock-top" aria-hidden="true">
                  <span class="mock-dot"></span><span class="mock-dot"></span><span class="mock-dot"></span>
                </div>

                <div class="mock-content">
                  <div class="mock-label">Promptendium</div>
                  <div class="mock-title level-copy" data-level="children">AI prompts made easier.</div>
                  <div class="mock-title level-copy" data-level="everyday">Find the right prompt faster.</div>
                  <div class="mock-title level-copy" data-level="technical">Prompt with more control.</div>

                  <div class="mock-search" aria-label="Animated Promptendium search example">
                    <span class="mock-query"><span id="mockQuery">Search prompts, guides and terms…</span><span class="typing-cursor" aria-hidden="true"></span></span>
                    <span class="mock-key">⌘ K</span>
                  </div>

                  <div class="mock-cards">
                    <div class="mock-card dark">
                      <strong>Prompt Dictionary</strong>
                      <span>Browse practical prompts by task, category or letter.</span>
                      <div class="mock-purple"></div>
                    </div>

                    <div class="mock-card">
                      <strong>Prompting Guides</strong>
                      <span>Learn the ideas that make prompts easier to write and improve.</span>
                    </div>

                    <div class="mock-card">
                      <strong>AI terminology</strong>
                      <span>Plain-English definitions for the terms you actually see.</span>
                    </div>

                    <div class="mock-card">
                      <strong>Prompt Generator</strong>
                      <span>A guided tool for building prompts around your task.</span>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </section>
      </main>
    </div>

    <script is:inline>
      (() => {
        const root = document.documentElement;
        const buttons = Array.from(document.querySelectorAll('[data-audience-level]'));
        const validLevels = ['children', 'everyday', 'technical'];

        const applyLevel = (level, save = true, animate = true) => {
          const nextLevel = validLevels.includes(level) ? level : 'everyday';
          root.dataset.level = nextLevel;

          buttons.forEach((button) => {
            button.setAttribute('aria-pressed', String(button.dataset.audienceLevel === nextLevel));
          });

          if (save) {
            try {
              localStorage.setItem('promptendium-level', nextLevel);
            } catch {}
          }

          if (animate) {
            document.querySelectorAll(`.level-copy[data-level="${nextLevel}"]`).forEach((node) => {
              node.classList.remove('audience-transition');
              void node.offsetWidth;
              node.classList.add('audience-transition');
              window.setTimeout(() => node.classList.remove('audience-transition'), 700);
            });
          }

          window.dispatchEvent(new CustomEvent('promptendium-level-change', { detail: { level: nextLevel } }));
        };

        buttons.forEach((button) => {
          button.addEventListener('click', () => applyLevel(button.dataset.audienceLevel));
        });

        applyLevel(root.dataset.level || 'everyday', false, false);
      })();
    </script>

    <script is:inline>
      (() => {
        const root = document.documentElement;
        const toggle = document.getElementById('themeToggle');
        const themeColor = document.getElementById('themeColor');

        if (!toggle) return;

        const applyTheme = (theme, save = true) => {
          const dark = theme === 'dark';
          root.dataset.theme = dark ? 'dark' : 'light';
          toggle.setAttribute('aria-pressed', String(dark));
          toggle.setAttribute('aria-label', dark ? 'Switch to light mode' : 'Switch to dark mode');
          if (themeColor) themeColor.setAttribute('content', dark ? '#0F0F10' : '#F7F6F2');

          if (save) {
            try {
              localStorage.setItem('promptendium-theme', dark ? 'dark' : 'light');
            } catch {}
          }
        };

        applyTheme(root.dataset.theme || 'light', false);

        toggle.addEventListener('click', () => {
          applyTheme(root.dataset.theme === 'dark' ? 'light' : 'dark');
        });
      })();
    </script>

    <script is:inline>
      (() => {
        const query = document.getElementById('mockQuery');
        if (!query) return;

        const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        const phrasesByLevel = {
          children: [
            'Search simple prompts and guides…',
            'Explain photosynthesis simply',
            'Help me plan a school project',
            'Create a quiz about volcanoes'
          ],
          everyday: [
            'Search prompts, guides and terms…',
            'Write a professional follow-up email',
            'Explain context windows simply',
            'Create a project planning prompt'
          ],
          technical: [
            'Search advanced prompting techniques…',
            'Design a structured JSON output prompt',
            'Compare retrieval strategies for RAG',
            'Create a constrained system prompt'
          ]
        };

        let timer = null;
        let phraseIndex = 0;
        let charIndex = 0;
        let deleting = true;
        let phrases = phrasesByLevel.everyday;

        const schedule = (fn, delay) => {
          timer = window.setTimeout(fn, delay);
        };

        const tick = () => {
          const phrase = phrases[phraseIndex];

          if (deleting) {
            charIndex = Math.max(0, charIndex - 1);
            query.textContent = phrase.slice(0, charIndex);

            if (charIndex === 0) {
              deleting = false;
              phraseIndex = (phraseIndex + 1) % phrases.length;
              schedule(tick, 700);
              return;
            }

            schedule(tick, 58);
            return;
          }

          const nextPhrase = phrases[phraseIndex];
          charIndex = Math.min(nextPhrase.length, charIndex + 1);
          query.textContent = nextPhrase.slice(0, charIndex);

          if (charIndex === nextPhrase.length) {
            deleting = true;
            schedule(tick, 3400);
            return;
          }

          schedule(tick, 95);
        };

        const restart = (level) => {
          if (timer) window.clearTimeout(timer);
          phrases = phrasesByLevel[level] || phrasesByLevel.everyday;
          phraseIndex = 0;
          charIndex = phrases[0].length;
          deleting = true;
          query.textContent = phrases[0];

          if (!reduceMotion) schedule(tick, 4000);
        };

        restart(document.documentElement.dataset.level || 'everyday');

        window.addEventListener('promptendium-level-change', (event) => {
          restart(event.detail?.level || 'everyday');
        });
      })();
    </script>
  </body>
</html>