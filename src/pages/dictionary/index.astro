---
const letters = 'ABCDEFGHIJKLMNOPQRSTUVWXYZ'.split('');
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <title>AI Prompt Dictionary A–Z | Promptendium</title>
    <meta
      name="description"
      content="Browse practical AI prompts A–Z or by category. Find carefully structured prompts for work, writing, research, career tasks and business."
    />
    <meta name="theme-color" content="#F7F6F2" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content="AI Prompt Dictionary A–Z | Promptendium" />
    <meta
      property="og:description"
      content="Browse practical AI prompts alphabetically or by category, then open a dedicated page to copy, understand and customise each prompt."
    />
    <meta name="twitter:card" content="summary" />
    <link rel="icon" type="image/png" href="/favicon.png" />

    <style is:global>
      :root {
        --paper:#F7F6F2;
        --paper-2:#FCFBF8;
        --ink:#151515;
        --muted:#706E68;
        --line:#DCD9D1;
        --violet:#6D4AFF;
        --violet-dark:#5637DB;
        --violet-soft:#ECE8FF;
        --max:1220px;
        --shadow:0 18px 60px rgba(21,21,21,.08);
      }
      * { box-sizing:border-box; }
      html { scroll-behavior:smooth; }
      body {
        margin:0; background:var(--paper); color:var(--ink);
        font-family:Inter,ui-sans-serif,system-ui,-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif;
        line-height:1.55; -webkit-font-smoothing:antialiased;
      }
      a { color:inherit; text-decoration:none; }
      button,input { font:inherit; }
      img { display:block; max-width:100%; }
      .wrap { width:min(calc(100% - 38px),var(--max)); margin-inline:auto; }
      .site-header {
        position:sticky; top:0; z-index:50; background:rgba(247,246,242,.9);
        backdrop-filter:blur(18px); border-bottom:1px solid rgba(220,217,209,.9);
      }
      .header-inner { min-height:78px; display:flex; align-items:center; justify-content:space-between; gap:24px; }
      .header-logo { width:300px; display:flex; align-items:center; }
      .header-logo img { width:100%; height:auto; }
      .nav { display:flex; align-items:center; gap:28px; font-size:14px; font-weight:700; color:#3D3A36; }
      .nav a:hover,.nav .active { color:var(--violet); }
      .nav-cta { border-radius:999px; padding:10px 16px; background:var(--ink); color:#fff!important; }
      h1,h2,h3 { margin:0; font-family:Georgia,"Times New Roman",serif; font-weight:500; letter-spacing:-.04em; }
      .kicker { color:var(--violet); text-transform:uppercase; letter-spacing:.12em; font-size:11px; font-weight:900; margin-bottom:9px; }
      .badge {
        display:inline-flex; align-items:center; gap:9px; padding:8px 12px;
        border:1px solid var(--line); border-radius:999px; background:rgba(255,255,255,.55);
        color:#4B4944; font-weight:750; font-size:13px;
      }
      .dot { width:7px; height:7px; background:var(--violet); border-radius:50%; }

      .hero { position:relative; padding:78px 0 54px; overflow:hidden; }
      .hero::after {
        content:""; position:absolute; width:520px; height:520px; border-radius:50%;
        right:-180px; top:-180px; background:radial-gradient(circle,rgba(109,74,255,.13),transparent 68%);
        pointer-events:none;
      }
      .hero-grid {
        position:relative; z-index:1; display:grid; grid-template-columns:minmax(0,1.25fr) minmax(300px,.75fr);
        gap:60px; align-items:end;
      }
      h1 { font-size:clamp(54px,7vw,92px); line-height:.94; margin:22px 0; max-width:790px; }
      .lede { font-size:clamp(18px,2vw,22px); color:var(--muted); max-width:710px; margin:0; }
      .hero-card { border:1px solid var(--line); background:rgba(255,255,255,.66); border-radius:22px; padding:28px; }
      .hero-card h2 { font-size:31px; line-height:1.05; margin-bottom:12px; }
      .hero-card p { color:var(--muted); margin:0; }

      .search-wrap { padding:0 0 34px; }
      .search {
        display:flex; align-items:center; gap:8px; max-width:900px; background:#fff;
        border:1px solid var(--line); padding:9px; border-radius:18px; box-shadow:var(--shadow);
      }
      .search-icon { width:46px; height:46px; display:grid; place-items:center; border-radius:13px; background:#F0EEE8; flex:0 0 auto; }
      .search input { flex:1; min-width:0; border:0; outline:0; background:transparent; padding:0 8px; font-size:16px; }
      .search button { border:0; cursor:pointer; border-radius:12px; background:var(--violet); color:#fff; font-weight:850; padding:14px 18px; }
      .search button:hover { background:var(--violet-dark); }

      .browse-panel { background:var(--paper-2); border-top:1px solid var(--line); border-bottom:1px solid var(--line); }
      .browse-inner { padding:30px 0; }
      .browse-head { display:grid; grid-template-columns:1fr minmax(260px,430px); gap:40px; align-items:end; margin-bottom:22px; }
      .browse-head h2 { font-size:34px; line-height:1.05; }
      .browse-head p { margin:0; color:var(--muted); font-size:14px; }
      .category-row { display:flex; gap:8px; flex-wrap:wrap; margin-bottom:24px; }
      .cat {
        border:1px solid var(--line); background:#fff; border-radius:999px; padding:9px 13px;
        color:#55514b; font-size:13px; font-weight:750; cursor:pointer;
      }
      .cat:hover,.cat.active { background:var(--violet-soft); border-color:#c8bfff; color:var(--violet-dark); }
      .az-meta { display:flex; justify-content:space-between; gap:20px; align-items:center; margin-bottom:12px; }
      .az-meta strong { font-size:13px; }
      .az-meta span { color:var(--muted); font-size:12px; }
      .alphabet { display:grid; grid-template-columns:repeat(27,1fr); gap:5px; }
      .letter {
        min-width:0; height:42px; border:1px solid var(--line); background:#fff; border-radius:10px;
        display:grid; place-items:center; font-weight:850; font-size:13px; cursor:pointer; color:#55514b;
      }
      .letter:hover:not(:disabled),.letter.active { background:var(--ink); color:#fff; border-color:var(--ink); }
      .letter:disabled { opacity:.28; cursor:not-allowed; background:#F2F0EB; }

      .main { padding:58px 0 82px; }
      .toolbar { display:flex; align-items:end; justify-content:space-between; gap:24px; margin-bottom:24px; }
      .toolbar h2 { font-size:clamp(36px,4vw,52px); line-height:1; }
      .result-count { color:var(--muted); font-size:13px; }

      .featured { display:grid; grid-template-columns:1.2fr .8fr .8fr; gap:12px; margin-bottom:50px; }
      .prompt-card {
        border:1px solid var(--line); border-radius:18px; background:rgba(255,255,255,.62);
        padding:22px; min-height:210px; display:flex; flex-direction:column; transition:.18s ease;
      }
      .prompt-card:hover { transform:translateY(-3px); background:#fff; border-color:#bdb5e8; }
      .prompt-card.feature { background:var(--ink); color:#fff; border-color:var(--ink); min-height:270px; }
      .pill { font-size:11px; text-transform:uppercase; letter-spacing:.09em; font-weight:900; color:var(--violet); }
      .feature .pill { color:#ad9fff; }
      .prompt-card h3 { font-size:26px; line-height:1.08; margin:auto 0 10px; }
      .prompt-card.feature h3 { font-size:36px; }
      .prompt-card p { margin:0; color:var(--muted); font-size:14px; }
      .prompt-card.feature p { color:#bbb7b0; }
      .card-link { margin-top:18px; font-weight:800; font-size:13px; }

      .alpha-group { margin-top:48px; scroll-margin-top:112px; }
      .alpha-heading { display:flex; align-items:center; gap:18px; margin-bottom:15px; }
      .big-letter { font-family:Georgia,serif; font-size:56px; line-height:1; color:var(--violet); }
      .rule { height:1px; background:var(--line); flex:1; }
      .prompt-list { display:grid; gap:10px; }
      .list-card {
        display:grid; grid-template-columns:1fr auto; gap:24px; align-items:center; border:1px solid var(--line);
        border-radius:15px; background:rgba(255,255,255,.5); padding:20px 22px; transition:.16s ease;
      }
      .list-card:hover { background:#fff; border-color:#c3bbe9; }
      .list-card h3 { font-family:inherit; letter-spacing:0; font-size:17px; font-weight:850; margin-bottom:5px; }
      .list-card p { margin:0; color:var(--muted); font-size:14px; max-width:760px; }
      .meta { display:flex; gap:8px; flex-wrap:wrap; margin-top:10px; }
      .meta span { font-size:11px; font-weight:800; color:#706c65; background:#eeece6; border-radius:999px; padding:5px 8px; }
      .open { color:var(--violet); font-size:22px; }
      .empty { display:none; padding:42px; border:1px dashed var(--line); border-radius:16px; color:var(--muted); text-align:center; }

      footer { padding:32px 0 45px; border-top:1px solid var(--line); }
      .footer-inner { display:flex; justify-content:space-between; align-items:center; gap:24px; flex-wrap:wrap; color:#6D6962; font-size:13px; }
      .footer-brand { display:flex; align-items:center; gap:10px; color:var(--ink); font-weight:850; }
      .footer-brand img { width:36px; height:36px; object-fit:contain; }
      .footer-links { display:flex; gap:20px; flex-wrap:wrap; }

      @media (max-width:980px) {
        .nav a:not(.nav-cta) { display:none; }
        .header-logo { width:245px; }
        .hero-grid,.browse-head { grid-template-columns:1fr; }
        .alphabet { grid-template-columns:repeat(14,1fr); }
        .featured { grid-template-columns:1fr 1fr; }
        .prompt-card.feature { grid-column:1/-1; }
      }
      @media (max-width:650px) {
        .wrap { width:min(calc(100% - 24px),var(--max)); }
        .header-inner { min-height:67px; }
        .header-logo { width:205px; }
        .nav-cta { padding:9px 12px; font-size:12px; }
        .hero { padding:54px 0 42px; }
        h1 { font-size:55px; }
        .search { flex-wrap:wrap; }
        .search-icon { display:none; }
        .search input { min-height:46px; }
        .search button { width:100%; }
        .browse-head { gap:14px; }
        .az-meta { align-items:flex-start; flex-direction:column; gap:2px; }
        .alphabet { display:flex; overflow-x:auto; padding-bottom:7px; }
        .letter { min-width:42px; flex:0 0 42px; }
        .featured { grid-template-columns:1fr; }
        .prompt-card.feature { grid-column:auto; }
        .toolbar { align-items:flex-start; flex-direction:column; }
        .list-card { padding:18px; }
      }
    </style>
  </head>
  <body>
    <header class="site-header">
      <div class="wrap header-inner">
        <a href="/" class="header-logo" aria-label="Promptendium home">
          <img src="/brand/promptendium-logo.webp" alt="Promptendium — The reference for better AI prompts." width="1256" height="303" />
        </a>
        <nav class="nav" aria-label="Primary navigation">
          <a href="/dictionary/" class="active">Dictionary</a>
          <a href="/#learn">Learn</a>
          <a href="/#guides">Guides</a>
          <a href="/#examples">Prompt Examples</a>
          <a href="/#about" class="nav-cta">About</a>
        </nav>
      </div>
    </header>

    <main>
      <section class="hero">
        <div class="wrap hero-grid">
          <div>
            <div class="badge"><span class="dot"></span> Practical AI prompt library</div>
            <h1>The AI Prompt Dictionary.</h1>
            <p class="lede">
              Browse prompts like a dictionary — alphabetically from A to Z, or choose a category and browse that category A–Z.
            </p>
          </div>
          <aside class="hero-card">
            <div class="kicker">The Promptendium approach</div>
            <h2>Find the prompt. Understand it. Adapt it.</h2>
            <p>Every prompt opens to a dedicated page with a copy-ready version, instructions, customisation ideas and practical examples.</p>
          </aside>
        </div>
      </section>

      <section class="search-wrap">
        <div class="wrap">
          <form class="search" id="promptSearch" role="search">
            <div class="search-icon" aria-hidden="true">⌕</div>
            <input id="q" placeholder="Search prompts: email, meeting notes, research, CV…" aria-label="Search the prompt dictionary" />
            <button type="submit">Search prompts</button>
          </form>
        </div>
      </section>

      <section class="browse-panel" aria-labelledby="browse-heading">
        <div class="wrap browse-inner">
          <div class="browse-head">
            <div>
              <div class="kicker">Browse the dictionary</div>
              <h2 id="browse-heading">Choose a category, then a letter.</h2>
            </div>
            <p>The A–Z selector stays available for every category. Letters with no matching prompts are disabled automatically.</p>
          </div>

          <div class="category-row" aria-label="Prompt categories">
            <button class="cat active" type="button" data-cat="All">All prompts</button>
            <button class="cat" type="button" data-cat="Work & Productivity">Work & Productivity</button>
            <button class="cat" type="button" data-cat="Writing & Editing">Writing & Editing</button>
            <button class="cat" type="button" data-cat="Career">Career</button>
            <button class="cat" type="button" data-cat="Research & Learning">Research & Learning</button>
            <button class="cat" type="button" data-cat="Business & Marketing">Business & Marketing</button>
          </div>

          <div class="az-meta">
            <strong id="azTitle">All prompts A–Z</strong>
            <span id="azHint">Choose a letter or leave All selected.</span>
          </div>

          <div class="alphabet" aria-label="Browse prompts alphabetically">
            <button class="letter active" type="button" data-letter="ALL">All</button>
            {letters.map((letter) => (
              <button class="letter" type="button" data-letter={letter}>{letter}</button>
            ))}
          </div>
        </div>
      </section>

      <section class="main">
        <div class="wrap">
          <div class="toolbar">
            <div>
              <div class="kicker">Prompt library</div>
              <h2 id="resultTitle">All prompts A–Z</h2>
            </div>
            <div class="result-count" id="count">12 prototype prompts</div>
          </div>

          <div class="featured" id="featured">
            <a
              class="prompt-card feature"
              href="/prompts/turn-meeting-notes-into-clear-action-items/"
            >
              <div class="pill">Featured · Work & Productivity</div>
              <h3>Turn meeting notes into clear action items</h3>
              <p>Extract decisions, owners, deadlines and unresolved questions from messy notes.</p>
              <div class="card-link">Open prompt →</div>
            </a>
            <a class="prompt-card" href="#D">
              <div class="pill">Writing & Editing</div>
              <h3>Draft a concise professional email</h3>
              <p>Write a clear email from purpose, audience, context and desired next action.</p>
              <div class="card-link">Browse D →</div>
            </a>
            <a class="prompt-card" href="#B">
              <div class="pill">Research & Learning</div>
              <h3>Build a focused learning plan</h3>
              <p>Turn a broad subject into a practical sequence of learning goals and checkpoints.</p>
              <div class="card-link">Browse B →</div>
            </a>
          </div>

          <div id="groups">
            <section class="alpha-group" id="B" data-group="B">
              <div class="alpha-heading"><div class="big-letter">B</div><div class="rule"></div></div>
              <div class="prompt-list">
                <a class="list-card prompt-item" data-letter="B" data-cat="Research & Learning" data-search="build focused learning plan new topic study research" href="#">
                  <div>
                    <h3>Build a focused learning plan for a new topic</h3>
                    <p>Break a broad subject into objectives, stages and practical checkpoints.</p>
                    <div class="meta"><span>Research & Learning</span><span>Learning</span></div>
                  </div><div class="open">→</div>
                </a>
              </div>
            </section>

            <section class="alpha-group" id="C" data-group="C">
              <div class="alpha-heading"><div class="big-letter">C</div><div class="rule"></div></div>
              <div class="prompt-list">
                <a class="list-card prompt-item" data-letter="C" data-cat="Work & Productivity" data-search="create concise project status update stakeholders report" href="#">
                  <div><h3>Create a concise project status update</h3><p>Turn raw project information into a clear update for stakeholders.</p><div class="meta"><span>Work & Productivity</span><span>Projects</span></div></div><div class="open">→</div>
                </a>
                <a class="list-card prompt-item" data-letter="C" data-cat="Business & Marketing" data-search="create practical content brief marketing seo article outline" href="#">
                  <div><h3>Create a practical content brief</h3><p>Define audience, intent, scope, required evidence and useful page structure.</p><div class="meta"><span>Business & Marketing</span><span>Content</span></div></div><div class="open">→</div>
                </a>
                <a class="list-card prompt-item" data-letter="C" data-cat="Research & Learning" data-search="compare multiple sources claims research evidence" href="#">
                  <div><h3>Compare multiple sources on the same question</h3><p>Structure agreements, disagreements, evidence quality and unresolved points.</p><div class="meta"><span>Research & Learning</span><span>Research</span></div></div><div class="open">→</div>
                </a>
              </div>
            </section>

            <section class="alpha-group" id="D" data-group="D">
              <div class="alpha-heading"><div class="big-letter">D</div><div class="rule"></div></div>
              <div class="prompt-list">
                <a class="list-card prompt-item" data-letter="D" data-cat="Writing & Editing" data-search="draft concise professional email writing" href="#">
                  <div><h3>Draft a concise professional email</h3><p>Write a clear email from purpose, audience, context and desired next action.</p><div class="meta"><span>Writing & Editing</span><span>Email</span></div></div><div class="open">→</div>
                </a>
                <a class="list-card prompt-item" data-letter="D" data-cat="Business & Marketing" data-search="define useful customer profile persona audience marketing" href="#">
                  <div><h3>Define a useful customer profile</h3><p>Turn known customer evidence into practical needs, constraints and buying context.</p><div class="meta"><span>Business & Marketing</span><span>Audience</span></div></div><div class="open">→</div>
                </a>
              </div>
            </section>

            <section class="alpha-group" id="P" data-group="P">
              <div class="alpha-heading"><div class="big-letter">P</div><div class="rule"></div></div>
              <div class="prompt-list">
                <a class="list-card prompt-item" data-letter="P" data-cat="Career" data-search="prepare job interview questions answers career" href="#">
                  <div><h3>Prepare for a job interview</h3><p>Generate role-relevant questions and a structured preparation plan.</p><div class="meta"><span>Career</span><span>Interview</span></div></div><div class="open">→</div>
                </a>
                <a class="list-card prompt-item" data-letter="P" data-cat="Work & Productivity" data-search="prioritise long task list workload priorities productivity" href="#">
                  <div><h3>Prioritise a long task list</h3><p>Organise competing tasks by urgency, impact, dependencies and effort.</p><div class="meta"><span>Work & Productivity</span><span>Planning</span></div></div><div class="open">→</div>
                </a>
                <a class="list-card prompt-item" data-letter="P" data-cat="Writing & Editing" data-search="proofread errors consistency grammar punctuation" href="#">
                  <div><h3>Proofread for errors and consistency</h3><p>Review text for grammar, punctuation, inconsistencies and unclear wording.</p><div class="meta"><span>Writing & Editing</span><span>Proofreading</span></div></div><div class="open">→</div>
                </a>
              </div>
            </section>

            <section class="alpha-group" id="R" data-group="R">
              <div class="alpha-heading"><div class="big-letter">R</div><div class="rule"></div></div>
              <div class="prompt-list">
                <a class="list-card prompt-item" data-letter="R" data-cat="Writing & Editing" data-search="rewrite text clarity meaning editing writing" href="#">
                  <div><h3>Rewrite text for clarity without changing the meaning</h3><p>Make writing easier to read while preserving facts, intent and tone.</p><div class="meta"><span>Writing & Editing</span><span>Editing</span></div></div><div class="open">→</div>
                </a>
              </div>
            </section>

            <section class="alpha-group" id="T" data-group="T">
              <div class="alpha-heading"><div class="big-letter">T</div><div class="rule"></div></div>
              <div class="prompt-list">
                <a class="list-card prompt-item" data-letter="T" data-cat="Career" data-search="tailor cv resume job description application" href="#">
                  <div><h3>Tailor a CV to a job description</h3><p>Identify relevant experience and improve alignment without inventing credentials.</p><div class="meta"><span>Career</span><span>Applications</span></div></div><div class="open">→</div>
                </a>
                <a class="list-card prompt-item" data-letter="T" data-cat="Work & Productivity" data-search="turn meeting notes clear action items decisions owners deadlines" href="/prompts/turn-meeting-notes-into-clear-action-items/">
                  <div><h3>Turn meeting notes into clear action items</h3><p>Convert rough meeting notes into decisions, actions, owners, deadlines and follow-up questions.</p><div class="meta"><span>Work & Productivity</span><span>Meetings</span></div></div><div class="open">→</div>
                </a>
              </div>
            </section>
          </div>

          <div class="empty" id="empty">No prototype prompts match this category, letter or search yet.</div>
        </div>
      </section>
    </main>

    <footer>
      <div class="wrap footer-inner">
        <div class="footer-brand"><img src="/brand/promptendium-mark.webp" alt="" width="303" height="303" /><span>Promptendium</span></div>
        <div class="footer-links"><a href="/dictionary/">Dictionary</a><a href="/#learn">Learn</a><a href="/#guides">Guides</a><a href="/#about">About</a><a href="#">Privacy</a></div>
        <div>© 2026 Promptendium</div>
      </div>
    </footer>

    <script>
      const searchForm = document.getElementById('promptSearch');
      const q = document.getElementById('q');
      const items = [...document.querySelectorAll('.prompt-item')];
      const groups = [...document.querySelectorAll('.alpha-group')];
      const categoryButtons = [...document.querySelectorAll('.cat')];
      const letterButtons = [...document.querySelectorAll('.letter')];
      const featured = document.getElementById('featured');

      let currentCategory = 'All';
      let currentLetter = 'ALL';

      function categoryLetters() {
        return new Set(
          items
            .filter((item) => currentCategory === 'All' || item.dataset.cat === currentCategory)
            .map((item) => item.dataset.letter)
        );
      }

      function updateAlphabet() {
        const available = categoryLetters();
        letterButtons.forEach((button) => {
          if (button.dataset.letter === 'ALL') {
            button.disabled = false;
            return;
          }
          button.disabled = !available.has(button.dataset.letter);
        });

        const label = currentCategory === 'All' ? 'All prompts A–Z' : `${currentCategory} A–Z`;
        document.getElementById('azTitle').textContent = label;
      }

      function applyFilters() {
        const query = q.value.trim().toLowerCase();
        let shown = 0;

        items.forEach((item) => {
          const categoryOK = currentCategory === 'All' || item.dataset.cat === currentCategory;
          const letterOK = currentLetter === 'ALL' || item.dataset.letter === currentLetter;
          const searchOK = !query || `${item.dataset.search} ${item.textContent}`.toLowerCase().includes(query);
          const visible = categoryOK && letterOK && searchOK;
          item.style.display = visible ? '' : 'none';
          if (visible) shown += 1;
        });

        groups.forEach((group) => {
          const visible = [...group.querySelectorAll('.prompt-item')].some((item) => item.style.display !== 'none');
          group.style.display = visible ? '' : 'none';
        });

        const defaultView = currentCategory === 'All' && currentLetter === 'ALL' && !query;
        featured.style.display = defaultView ? 'grid' : 'none';

        const scope = currentCategory === 'All' ? 'prompts' : currentCategory;
        document.getElementById('resultTitle').textContent =
          currentLetter === 'ALL' ? `${scope} A–Z` : `${scope}: ${currentLetter}`;
        document.getElementById('count').textContent = `${shown} prototype prompt${shown === 1 ? '' : 's'}`;
        document.getElementById('empty').style.display = shown ? 'none' : 'block';
      }

      categoryButtons.forEach((button) => {
        button.addEventListener('click', () => {
          currentCategory = button.dataset.cat;
          currentLetter = 'ALL';
          categoryButtons.forEach((candidate) => candidate.classList.toggle('active', candidate === button));
          letterButtons.forEach((candidate) => candidate.classList.toggle('active', candidate.dataset.letter === 'ALL'));
          updateAlphabet();
          applyFilters();
        });
      });

      letterButtons.forEach((button) => {
        button.addEventListener('click', () => {
          if (button.disabled) return;
          currentLetter = button.dataset.letter;
          letterButtons.forEach((candidate) => candidate.classList.toggle('active', candidate === button));
          applyFilters();
          if (currentLetter !== 'ALL') history.replaceState(null, '', `#${currentLetter}`);
          else history.replaceState(null, '', location.pathname);
          document.querySelector('.main').scrollIntoView({ behavior:'smooth' });
        });
      });

      searchForm.addEventListener('submit', (event) => {
        event.preventDefault();
        applyFilters();
      });
      q.addEventListener('input', applyFilters);

      const initialHash = location.hash.replace('#', '').toUpperCase();
      if (/^[A-Z]$/.test(initialHash)) {
        const target = letterButtons.find((button) => button.dataset.letter === initialHash && !button.disabled);
        if (target) {
          currentLetter = initialHash;
          letterButtons.forEach((candidate) => candidate.classList.toggle('active', candidate === target));
        }
      }

      updateAlphabet();
      applyFilters();
    </script>
  </body>
</html>
