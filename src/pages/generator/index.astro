<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <title>AI Prompt Generator | Promptendium</title>
    <meta
      name="description"
      content="Promptendium's AI Prompt Generator is being prepared as a dedicated tool for building clear, useful AI prompts."
    />
    <meta name="robots" content="noindex,follow" />
    <meta name="theme-color" content="#F7F6F2" />
    <link rel="icon" type="image/png" href="/favicon.png" />

    <style is:global>
      :root {
        --paper:#F7F6F2;
        --paper-2:#FCFBF8;
        --ink:#151515;
        --muted:#706E68;
        --line:#DCD9D1;
        --violet:#6D4AFF;
        --violet-dark:#5637DB;
        --violet-soft:#ECE8FF;
        --max:1220px;
        --shadow:0 18px 60px rgba(21,21,21,.08);
      }

      * { box-sizing:border-box; }
      html { scroll-behavior:smooth; }
      body {
        margin:0;
        background:var(--paper);
        color:var(--ink);
        font-family:Inter,ui-sans-serif,system-ui,-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif;
        line-height:1.55;
        -webkit-font-smoothing:antialiased;
      }

      a { color:inherit; text-decoration:none; }
      img { display:block; max-width:100%; }
      .wrap { width:min(calc(100% - 38px),var(--max)); margin-inline:auto; }

      .site-header {
        position:sticky;
        top:0;
        z-index:40;
        background:rgba(247,246,242,.92);
        backdrop-filter:blur(18px);
        border-bottom:1px solid rgba(220,217,209,.9);
      }

      .header-inner {
        min-height:78px;
        display:flex;
        align-items:center;
        justify-content:space-between;
        gap:24px;
      }

      .header-logo { width:300px; display:flex; align-items:center; }
      .header-logo img { width:100%; height:auto; }

      .nav {
        display:flex;
        align-items:center;
        gap:28px;
        font-size:14px;
        font-weight:700;
        color:#3D3A36;
      }

      .nav a:hover,
      .nav .active { color:var(--violet); }

      .nav-cta {
        border-radius:999px;
        padding:10px 16px;
        background:var(--ink);
        color:#fff!important;
      }

      main { min-height:calc(100vh - 185px); }

      .hero {
        position:relative;
        overflow:hidden;
        padding:100px 0 110px;
      }

      .hero::after {
        content:"";
        position:absolute;
        width:600px;
        height:600px;
        border-radius:50%;
        right:-220px;
        top:-220px;
        background:radial-gradient(circle,rgba(109,74,255,.13),transparent 68%);
        pointer-events:none;
      }

      .hero-grid {
        position:relative;
        z-index:1;
        display:grid;
        grid-template-columns:minmax(0,1.2fr) minmax(300px,.8fr);
        gap:70px;
        align-items:center;
      }

      .eyebrow {
        display:inline-flex;
        align-items:center;
        gap:9px;
        padding:8px 12px;
        border:1px solid var(--line);
        border-radius:999px;
        background:rgba(255,255,255,.58);
        color:#4B4944;
        font-size:13px;
        font-weight:800;
      }

      .dot {
        width:7px;
        height:7px;
        border-radius:50%;
        background:var(--violet);
      }

      h1,
      h2 {
        margin:0;
        font-family:Georgia,"Times New Roman",serif;
        font-weight:500;
        letter-spacing:-.045em;
      }

      h1 {
        margin-top:24px;
        font-size:clamp(54px,7vw,92px);
        line-height:.95;
        max-width:820px;
      }

      .lede {
        margin:26px 0 0;
        max-width:710px;
        color:var(--muted);
        font-size:clamp(18px,2vw,22px);
      }

      .product-card {
        border:1px solid var(--line);
        background:rgba(255,255,255,.68);
        border-radius:24px;
        padding:30px;
        box-shadow:var(--shadow);
      }

      .product-card .label {
        color:var(--violet);
        text-transform:uppercase;
        letter-spacing:.12em;
        font-size:11px;
        font-weight:900;
      }

      .product-card h2 {
        margin:16px 0 12px;
        font-size:36px;
        line-height:1.05;
      }

      .product-card p {
        margin:0;
        color:var(--muted);
        font-size:15px;
      }

      .feature-list {
        display:grid;
        gap:10px;
        margin-top:24px;
      }

      .feature {
        display:flex;
        gap:10px;
        align-items:flex-start;
        padding-top:10px;
        border-top:1px solid var(--line);
        color:#4B4944;
        font-size:14px;
      }

      .feature strong { color:var(--ink); }
      .check { color:var(--violet); font-weight:900; }

      .note {
        margin-top:26px;
        padding:15px 17px;
        border-radius:14px;
        background:var(--violet-soft);
        color:#4D3BA5;
        font-size:13px;
        font-weight:700;
      }

      footer {
        padding:32px 0 45px;
        border-top:1px solid var(--line);
      }

      .footer-inner {
        display:flex;
        justify-content:space-between;
        align-items:center;
        gap:24px;
        flex-wrap:wrap;
        color:#6D6962;
        font-size:13px;
      }

      .footer-brand {
        display:flex;
        align-items:center;
        gap:10px;
        color:var(--ink);
        font-weight:850;
      }

      .footer-brand img { width:36px; height:36px; object-fit:contain; }
      .footer-links { display:flex; gap:20px; flex-wrap:wrap; }

      @media (max-width:980px) {
        .nav a:not(.nav-cta) { display:none; }
        .header-logo { width:245px; }
        .hero-grid { grid-template-columns:1fr; }
      }

      @media (max-width:650px) {
        .wrap { width:min(calc(100% - 24px),var(--max)); }
        .header-inner { min-height:67px; }
        .header-logo { width:205px; }
        .nav-cta { padding:9px 12px; font-size:12px; }
        .hero { padding:66px 0 72px; }
        h1 { font-size:56px; }
        .product-card { padding:24px; }
      }
    </style>
  </head>

  <body>
    <header class="site-header">
      <div class="wrap header-inner">
        <a href="/" class="header-logo" aria-label="Promptendium home">
          <img
            src="/brand/promptendium-logo.webp"
            alt="Promptendium — The reference for better AI prompts."
            width="1256"
            height="303"
          />
        </a>

        <nav class="nav" aria-label="Primary navigation">
          <a href="/dictionary/">Dictionary</a>
          <a href="/generator/" class="active">Prompt Generator</a>
          <a href="/#learn">Learn</a>
          <a href="/#guides">Guides</a>
          <a href="/#about" class="nav-cta">About</a>
        </nav>
      </div>
    </header>

    <main>
      <section class="hero">
        <div class="wrap hero-grid">
          <div>
            <div class="eyebrow"><span class="dot"></span> Promptendium tool</div>
            <h1>Build a better AI prompt.</h1>
            <p class="lede">
              The Promptendium Prompt Generator will turn a plain-English task into a clearer,
              more useful prompt with the right level of detail for what you are trying to do.
            </p>
          </div>

          <aside class="product-card" aria-label="Prompt Generator overview">
            <div class="label">In development</div>
            <h2>Prompt Generator</h2>
            <p>
              The generator is being developed as a separate Promptendium product. The public
              page is intentionally simple while the tool itself is developed independently.
            </p>

            <div class="feature-list">
              <div class="feature"><span class="check">✓</span><span><strong>Quick</strong> mode for fast prompt creation</span></div>
              <div class="feature"><span class="check">✓</span><span><strong>Detailed</strong> mode for useful guided questions</span></div>
              <div class="feature"><span class="check">✓</span><span><strong>Custom</strong> mode for full control</span></div>
            </div>

            <div class="note">Access, trial and subscription controls will be added separately before launch.</div>
          </aside>
        </div>
      </section>
    </main>

    <footer>
      <div class="wrap footer-inner">
        <div class="footer-brand">
          <img src="/brand/promptendium-mark.webp" alt="" width="303" height="303" />
          <span>Promptendium</span>
        </div>
        <div class="footer-links">
          <a href="/dictionary/">Dictionary</a>
          <a href="/generator/">Prompt Generator</a>
          <a href="/#learn">Learn</a>
          <a href="/#guides">Guides</a>
          <a href="/#about">About</a>
        </div>
        <div>© 2026 Promptendium</div>
      </div>
    </footer>
  </body>
</html>
